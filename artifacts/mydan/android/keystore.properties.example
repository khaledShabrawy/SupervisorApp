# keystore.properties.example
# ─────────────────────────────────────────────────────────────────────────────
# SAFE TO COMMIT — this is only a template with no real secrets.
#
# HOW TO USE:
#   1. Copy this file to  android/keystore.properties  (gitignored).
#   2. Generate your upload key ONCE (see command below).
#   3. Fill in the values below with your real keystore details.
#   4. Keep keystore.properties AND the .keystore file OUT of git forever.
#   5. Store a backup of both files somewhere secure OUTSIDE this repo
#      (encrypted cloud storage, password manager, etc.).
#
# ─────────────────────────────────────────────────────────────────────────────
# GENERATE UPLOAD KEY (run once, from the android/app/ directory):
#
#   keytool -genkeypair -v \
#     -keystore mydan-release.keystore \
#     -alias mydan \
#     -keyalg RSA -keysize 2048 \
#     -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD \
#     -keypass YOUR_KEY_PASSWORD \
#     -dname "CN=Mydan, OU=Mobile, O=YourCompany, L=City, S=State, C=AE"
#
# Windows (cmd/PowerShell): same command, keytool is in your JDK bin/.
# ─────────────────────────────────────────────────────────────────────────────
# BACKUP:
#   - Store a copy of mydan-release.keystore and this filled-in file in
#     an encrypted drive or password manager vault.
#   - If the keystore is lost you CANNOT update the app on Google Play.
# ─────────────────────────────────────────────────────────────────────────────

# Path to the keystore file, relative to the android/app/ directory
storeFile=mydan-release.keystore

# Keystore password (set during keytool -genkeypair)
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD

# Key alias (the -alias value you chose above)
keyAlias=mydan

# Key password (set during keytool -genkeypair)
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
