# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
*.apk
!artifacts/mydan/public/*.apk
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
HOME/
.claude-omniroute/
*.log

# local env
.env
.env.*.local
.env.local

# Local CLI tools & caches
bin/
supabase/.temp/

# Local session state and tokens
/HOME/.claude-omniroute/sessions/

# Database backups and encryption material (never commit production data)
/backups/
*.dump
*.dump.enc
*.sql.enc
*.enc.partial
*.backup-key
__pycache__/

# Android signing — never commit keystores
*.jks
*.keystore
*.p12
