modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_N8N_SHELF_AUDIT_WEBHOOK = "https://n8n.yourdomain.com/webhook/shelf-audit"
EXPO_PUBLIC_SUPABASE_URL = "https://ywdlrrdkjbtpfgacuuoy.supabase.co"

[nix]
channel = "stable-25_05"
